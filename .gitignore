# ==========================================
# Python & Flask Specific
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
instance/
.webassets-cache/
.env
.flaskenv


# ==========================================
# Environments & Dependencies
# ==========================================
# Virtual environments
env/
venv/
ENV/
env_seven/
.venv/


# Node/Frontend dependencies (if you use npm/yarn for JS/CSS assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.sass-cache/


# ==========================================
# Android / TWA wrapper (twa/)
# ==========================================
# Allowlist, not denylist: everything in twa/ is generated by `bubblewrap
# update` or Gradle except the two files named below (~56 MB of it, and
# `bubblewrap update` emits new files as versions change). Recreate a fresh
# clone with `bubblewrap update` — see twa/README.md.
twa/*
!twa/twa-manifest.json
!twa/README.md


# Build output and signing material, wherever they land.
*.apk
*.apk.idsig
*.aab
*.keystore
*.jks
*.keystore.password.txt


# ==========================================
# OS & IDE Clutter
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride


# Windows
Thumbs.db
ehthumbs.db


# IDEs (VS Code, PyCharm)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

